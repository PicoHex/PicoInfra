<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!--
      The local folder feed (artifacts/nupkg/) is deliberately NOT declared here.
      artifacts/ is gitignored, so a fresh clone or worktree has no such directory,
      and a declared-but-missing local source is a fatal NU1301 for every package
      that has to be resolved (it hides behind the global packages cache until a
      version is not cached yet). Directory.Build.props adds the same feed via
      RestoreAdditionalProjectSources only when the directory exists, so a clean
      checkout restores and local packers keep the feed.
    -->
  </packageSources>
</configuration>
