<Project>
  <!--
    Aggressive AOT tier implementation. Must live in this .targets file (not
    Directory.Build.props): a csproj-level <AotOptimizationLevel> is evaluated
    after Directory.Build.props, so a condition there never sees the override.
    Samples and benchmarks declare <AotOptimizationLevel>aggressive</AotOptimizationLevel>
    as the production-configuration preview; tests stay on minimal.
  -->
  <PropertyGroup Condition="'$(AotOptimizationLevel)' == 'aggressive'">
    <PublishAot Condition="'$(PublishAot)' == ''">true</PublishAot>
    <TrimMode Condition="'$(TrimMode)' == ''">full</TrimMode>
    <!-- .NET 10 SDK (>= 10.0.400): classic Ilc* properties were removed
         and are silently ignored; these are the verified replacements.
         InvariantGlobalization is an app-level decision (see csproj-format
         skill) and is intentionally NOT defaulted here. -->
    <StackTraceSupport>false</StackTraceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <!--
    PublishAotIfRequested: when PublishAotOnRun is true, intercepts dotnet run
    to publish as AOT first, then execute the native binary.
    Gates: only for Exe projects (libraries cannot self-publish).
  -->
  <Target
    Name="PublishAotIfRequested"
    BeforeTargets="Run"
    Condition="'$(PublishAotOnRun)' == 'true' and '$(OutputType)' == 'Exe'"
  >
    <Message Text="Publishing AOT build to $(PublishDir)..." Importance="high" />
    <PropertyGroup>
      <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
      <_AotPublishDir>$(BaseIntermediateOutputPath)aot-publish\</_AotPublishDir>
    </PropertyGroup>
    <Exec
      Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot;
        -c $(Configuration)
        -r $(RuntimeIdentifier)
        -p:PublishAot=true
        -o &quot;$(_AotPublishDir)&quot;"
    />
    <Exec
      Command="&quot;$(_AotPublishDir)$(AssemblyName)$(TargetExt)&quot;"
      WorkingDirectory="$(_AotPublishDir)"
    />
  </Target>
</Project>
