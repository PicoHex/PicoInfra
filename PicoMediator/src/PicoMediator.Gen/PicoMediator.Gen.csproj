<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PublishAot>false</PublishAot>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);RS1041;NU5128</NoWarn>
    <IsPackable>false</IsPackable>
    <Description>Source generator for PicoMediator — generates AOT-compatible request dispatch at compile time</Description>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <MSBuildWarningsAsMessages>MSB3026</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Analyzer release tracking (Roslyn RS2008): one row per DiagnosticDescriptor this
         generator emits, so a consumer-facing rule ID cannot be added, reworded or retired
         without a row appearing here. A build input only — it is not packed and does not
         change the analyzer assembly that ships inside the .Abs package. -->
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    <!-- The other half of the tracking: what a published version already carries. Declared as an
         input next to its pair, so neither file can be deleted without the build saying so and
         a future release-tracking check has both halves. -->
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
  </ItemGroup>

  <!-- NOTHING in the build reads these two files. Measured: Microsoft.CodeAnalysis.Analyzers
       arrives here as a buildTransitive asset only (project.assets.json has no `analyzers`
       entry for it), so the release-tracking analyzer never loads and RS2008 can never fire -
       not for a missing file, a deleted row, or a reworded rule. Two lanes disagreed on this;
       the asset graph settles it. So the tracking is a review record, and these targets are the
       only machine-enforced half: they turn a deleted file into a build error instead of
       letting the record rot into a lie. Enforcing the rows themselves needs the analyzer
       as a real `analyzers` asset (docs/releasing.md says what that would cost). -->
  <Target Name="_RequireAnalyzerReleasesFile" BeforeTargets="CoreCompile">
    <Error
      Condition="!Exists('$(MSBuildProjectDirectory)/AnalyzerReleases.Unshipped.md')"
      Text="AnalyzerReleases.Unshipped.md is missing while this generator still declares it as an AdditionalFiles input. Nothing in the build reads this file (the release-tracking analyzer is not loaded here), so this target is the only thing that notices - restore it or remove the AdditionalFiles item."
    />
    <!-- Same failure, other half: without the file the record of what already shipped to consumers
         is gone, and this target would guard one file of a two-file pair. No RS diagnostic fills
         that gap - this project gets Microsoft.CodeAnalysis.Analyzers as a `build` asset only, so
         the release-tracking analyzer never loads (see docs/releasing.md). -->
    <Error
      Condition="!Exists('$(MSBuildProjectDirectory)/AnalyzerReleases.Shipped.md')"
      Text="AnalyzerReleases.Shipped.md is missing while this generator still declares it as an AdditionalFiles input. Without it every shipped rule reads as unshipped and edits to already-published rule IDs stop being reported - restore the file, or delete the AdditionalFiles item with a reason."
    />
  </Target>
</Project>
