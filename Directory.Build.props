<Project>
  <PropertyGroup>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- Default: do not produce NuGet packages from every project in the repo -->
    <IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>

    <!-- Default version for local development; CI/release pipelines override via -p:Version=<tag> -->
    <Version>0.0.0-dev</Version>

    <!--
      Default to project references for inner-loop development.
      Release/pack pipelines can switch to PackageReference mode with
      -p:UseProjectReferences=false to validate and emit real NuGet dependencies.
    -->
    <UseProjectReferences Condition="'$(UseProjectReferences)' == ''">true</UseProjectReferences>
  </PropertyGroup>

  <!--
    Optional local folder feed: scripts/release.ps1 packs this repo here and
    sibling-repo development resolves not-yet-indexed versions from it.

    It is added ONLY when the directory exists, and never in NuGet.config:
    artifacts/ is gitignored, so a fresh clone or worktree has no such directory,
    and a declared-but-missing local source fails restore with NU1301 for every
    package that is not already in the global packages cache. This is the SDK's
    own idiom (Microsoft.NET.NuGetOfflineCache.targets gates the same property on
    Exists() for the offline/workload folder feeds).
  -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)artifacts/nupkg')">
    <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);$(MSBuildThisFileDirectory)artifacts/nupkg</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <!-- ===== AOT Strategy ===== -->

  <!--
    AotOptimizationLevel:
      minimal  — Tests and default. PublishAot + TrimMode only, fast compilation.
      aggressive — Samples and Benchmarks. Full trimming, no reflection, no debug info.
    Declare the tier per-project via <AotOptimizationLevel>; the aggressive-tier
    properties live in Directory.Build.targets (evaluated after the project file,
    so csproj-level declarations actually take effect there).
  -->
  <PropertyGroup>
    <AotOptimizationLevel Condition="'$(AotOptimizationLevel)' == ''">minimal</AotOptimizationLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AotOptimizationLevel)' == 'minimal'">
    <PublishAot Condition="'$(PublishAot)' == ''">true</PublishAot>
    <TrimMode Condition="'$(TrimMode)' == ''">full</TrimMode>
    <!-- NOTE: classic Ilc* MSBuild properties (IlcTrimMetadata,
         IlcFoldIdenticalMethodBodies, IlcDisableReflection, ...) were removed
         in .NET 10 SDK (>= 10.0.400) and are silently ignored - ILC uses its
         built-in defaults. Size levers now: StackTraceSupport,
         UseSystemResourceKeys, InvariantGlobalization (see csproj-format
         skill "Ilc* MSBuild properties are GONE"). -->
  </PropertyGroup>

  <!-- ⚠️ netstandard2.0 must NEVER AOT — this block MUST come after the AOT level blocks.
       Only source generators (PicoXxx.Gen) remain on netstandard2.0 (Roslyn loader
       compatibility); all Abs packages moved to net10.0 and follow the library AOT
       policy above. -->
  <PropertyGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETStandard'">
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <TrimMode>partial</TrimMode>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <!-- ===== Test / verification projects: managed build, AOT analysis kept =====

       A project whose parent folder is `tests` is a test host (TUnit on
       Microsoft.Testing.Platform) or a compile/run gate - never a shipping
       artefact. Shipping code lives under src/, samples/ and benchmarks/, so this
       condition cannot reach it; it is the same split PicoInfra.slnx uses.

       Why PublishAot=false is a correctness fix, not a convenience:
       PublishAot=true does not only affect `dotnet publish`. It also makes the SDK
       emit an AOT-shaped runtimeconfig.json for the ordinary managed build, with
       System.Runtime.CompilerServices.RuntimeFeature.IsDynamicCodeSupported=false.
       `dotnet test` still runs the assembly on the JIT, but Microsoft.Testing.Platform's
       CodeCoverage extension reads that flag to choose its in-process path, expects a
       pre-instrumented (native) binary, instruments nothing and writes an empty report
       (<packages />, 181 B, 0 classes). With PublishAot=false the extension takes its
       instrumentation path and the report carries real data.

       IsAotCompatible=true keeps the AOT/trim Roslyn analyzers (IL2xxx/IL3xxx) running
       on test code, so what `dotnet build` proves about AOT compatibility (the
       211-warning baseline) is unchanged - only the publish-time config shape is.

       Escape hatch: a command-line -p:PublishAot=true is a global property and still
       wins over this block, so `dotnet publish <test project>` keeps working. -->
  <PropertyGroup>
    <_PicoParentFolder>$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName('$(MSBuildProjectDirectory)'))))</_PicoParentFolder>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_PicoParentFolder)' == 'tests'">
    <PublishAot>false</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Libraries: declare AOT-compatible but do not self-publish.
       Only for TFMs that support AOT (net8.0+). -->
  <PropertyGroup>
    <IsAotCompatible
      Condition="'$(IsAotCompatible)' == '' and '$(OutputType)' != 'Exe' and $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))"
      >true</IsAotCompatible>
  </PropertyGroup>

  <!-- PublishAotOnRun: when true, dotnet run auto-publishes as AOT before executing.
       Defaults to false locally, true in CI. -->
  <PropertyGroup>
    <PublishAotOnRun Condition="'$(PublishAotOnRun)' == '' and '$(CI)' == 'true'"
      >true</PublishAotOnRun>
    <PublishAotOnRun Condition="'$(PublishAotOnRun)' == ''">false</PublishAotOnRun>
  </PropertyGroup>

  <!-- ===== NuGet audit ===== -->

  <!--
    GHSA-p3jp-9v83-76w9: Microsoft.DotNet.ILCompiler < 10.0.14, bundled by SDK 10.0.401's
    ILCompilerPackVersion=10.0.12 and pulled into every project by PublishAot=true.
    Scoped to this id on purpose: a NEW advisory must still fail the build.
    Remove this the moment the SDK bundles 10.0.14 (verify with a real PublishAot publish).
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-p3jp-9v83-76w9" />
  </ItemGroup>

  <!-- Common package metadata -->
  <PropertyGroup>
    <Authors>PicoHex</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/PicoHex/PicoInfra</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PicoHex/PicoInfra</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <!-- Deterministic build & SourceLink -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- XML doc warnings as errors for packable projects -->
  <PropertyGroup>
    <NoWarn Condition="'$(IsPackable)' != 'true'">$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Symbol packages (snupkg) are declared in Directory.Build.targets - the
       guard on IsPackable cannot be evaluated in this file. See the note there. -->

  <!-- SourceLink for source-level debugging -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
