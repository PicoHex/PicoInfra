<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StripSymbols>false</StripSymbols>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <AotOptimizationLevel>aggressive</AotOptimizationLevel>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseProjectReferences)' == 'true'">
    <ProjectReference Include="..\..\..\PicoDI\src\PicoDI\PicoDI.csproj" />
    <ProjectReference Include="..\..\src\PicoLog.DI\PicoLog.DI.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseProjectReferences)' != 'true'">
    <PackageReference Include="PicoDI" />
    <PackageReference Include="PicoLog.DI" />
  </ItemGroup>

  <ItemGroup>
    <!-- PicoDI.Generators analyzer —source-generates type-based Register* registrations -->
    <ProjectReference
      Include="..\..\..\PicoDI\src\PicoDI.Gen\PicoDI.Gen.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>

  <ItemGroup>
    <!-- PicoLog.Generators analyzer — source-generates [PicoLogMessage] method bodies -->
    <ProjectReference
      Include="..\..\src\PicoLog.Gen\PicoLog.Gen.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
</Project>
