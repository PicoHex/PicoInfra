<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)/Generated</CompilerGeneratedFilesOutputPath>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PicoAop.Abs\PicoAop.Abs.csproj" />
    <ProjectReference Include="..\..\src\PicoAop.DI\PicoAop.DI.csproj" />
    <ProjectReference
      Include="..\..\src\PicoAop.Gen\PicoAop.Gen.csproj"
      OutputItemType="Analyzer"
    />
    <ProjectReference
      Include="..\..\..\PicoDI\src\PicoDI.Gen\PicoDI.Gen.csproj"
      OutputItemType="Analyzer"
    />
    <ProjectReference Include="..\..\..\PicoDI\src\PicoDI\PicoDI.csproj" />
    <ProjectReference Include="..\..\..\PicoDI\src\PicoDI.Abs\PicoDI.Abs.csproj" />
  </ItemGroup>
</Project>
