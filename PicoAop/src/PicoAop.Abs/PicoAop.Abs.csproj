<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>PicoAop.Abs</PackageId>
    <Description>Abstractions for PicoAop — compile-time AOP interceptors for PicoDI</Description>
    <PackageTags>PicoHex;AOP;DI;Interceptor;Abstractions</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\PicoAop.Gen\PicoAop.Gen.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      PrivateAssets="all"
    />
  </ItemGroup>

  <ItemGroup Condition="'$(UseProjectReferences)' == 'true'">
    <ProjectReference Include="..\..\..\PicoDI\src\PicoDI.Abs\PicoDI.Abs.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseProjectReferences)' != 'true'">
    <PackageReference Include="PicoDI.Abs" />
  </ItemGroup>

  <ItemGroup>
    <None
      Include="..\PicoAop.Genin\$(Configuration)
etstandard2.0\PicoAop.Gen.dll"
      Pack="true"
      PackagePath="analyzers/dotnet/cs"
      Visible="false"
    />
    <None
      Include="buildTransitive\PicoAop.Abs.props"
      Pack="true"
      PackagePath="buildTransitive\PicoAop.Abs.props"
      Visible="false"
    />
  </ItemGroup>

</Project>
